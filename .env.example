# ── Sign-in (Google OAuth) ─────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Your app URL. Locally: http://localhost:3000  On Vercel: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ── Google Maps (travel time + places) ────────────────────────────
# Enable "Routes API" and "Places API (New)" for this key
GOOGLE_MAPS_API_KEY=

# ── Jun's brain (Claude) ──────────────────────────────────────────
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# ── Jun's voice (optional) ────────────────────────────────────────
# Without these, Jun uses your browser's built-in voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
